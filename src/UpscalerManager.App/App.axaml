<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UpscalerManager.App.App"
             Name="UpscalerManager"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette from DESIGN.md. Token names predate it; the values are the
                 design system's. Window canvas -> card surface-1 -> nested surface-3,
                 with controls lifted to surface-2. -->
            <Color x:Key="BgDeepColor">#0B0B12</Color>
            <Color x:Key="BgBaseColor">#0B0B12</Color>
            <Color x:Key="BgSurfaceColor">#1E1E2C</Color>
            <Color x:Key="BgCardColor">#13131C</Color>
            <Color x:Key="BgElevatedColor">#181824</Color>
            <Color x:Key="BorderSubtleColor">#22222F</Color>
            <Color x:Key="BorderDefaultColor">#2E2E3F</Color>
            <Color x:Key="AccentPrimaryColor">#8B73F8</Color>
            <Color x:Key="AccentPrimaryHoverColor">#9D88FF</Color>
            <Color x:Key="AccentPrimaryPressedColor">#7560E0</Color>
            <Color x:Key="TextPrimaryColor">#E8E8F2</Color>
            <Color x:Key="TextSecondaryColor">#9A9AB8</Color>
            <Color x:Key="TextDisabledColor">#5A5A78</Color>
            <Color x:Key="StatusSuccessColor">#5CB87E</Color>
            <Color x:Key="StatusErrorColor">#E06060</Color>
            <Color x:Key="StatusWarningColor">#D4A04A</Color>

            <!-- Fluent derives CheckBox, RadioButton, ComboBox and Slider from its own
                 accent, which is Windows blue until it is overridden here. -->
            <Color x:Key="SystemAccentColor">#8B73F8</Color>
            <Color x:Key="SystemAccentColorLight1">#9D88FF</Color>
            <Color x:Key="SystemAccentColorLight2">#AFA0FF</Color>
            <Color x:Key="SystemAccentColorLight3">#C2B7FF</Color>
            <Color x:Key="SystemAccentColorDark1">#7560E0</Color>
            <Color x:Key="SystemAccentColorDark2">#5F4DC0</Color>
            <Color x:Key="SystemAccentColorDark3">#4A3B9E</Color>

            <!-- One colour per vendor, used wherever a technology is named: Nvidia
                 green, AMD red, Intel blue. Muted rather than brand-saturated, so a
                 row of badges does not fight the rest of the UI, and the text on top
                 stays readable. -->
            <Color x:Key="TechNvidiaColor">#76B900</Color>
            <Color x:Key="TechAmdColor">#E8544A</Color>
            <Color x:Key="TechIntelColor">#4A9BE8</Color>

            <SolidColorBrush x:Key="BrBgDeep"     Color="{StaticResource BgDeepColor}"/>
            <SolidColorBrush x:Key="BrBgBase"     Color="{StaticResource BgBaseColor}"/>
            <SolidColorBrush x:Key="BrBgSurface"  Color="{StaticResource BgSurfaceColor}"/>
            <SolidColorBrush x:Key="BrBgCard"     Color="{StaticResource BgCardColor}"/>
            <SolidColorBrush x:Key="BrBgElevated" Color="{StaticResource BgElevatedColor}"/>
            <SolidColorBrush x:Key="BrBorderSubtle"  Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="BrBorderDefault" Color="{StaticResource BorderDefaultColor}"/>
            <SolidColorBrush x:Key="BrAccent"        Color="{StaticResource AccentPrimaryColor}"/>
            <SolidColorBrush x:Key="BrAccentHover"   Color="{StaticResource AccentPrimaryHoverColor}"/>
            <SolidColorBrush x:Key="BrAccentPressed" Color="{StaticResource AccentPrimaryPressedColor}"/>
            <SolidColorBrush x:Key="BrTextPrimary"   Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="BrTextDisabled"  Color="{StaticResource TextDisabledColor}"/>
            <SolidColorBrush x:Key="BrTechNvidia" Color="{StaticResource TechNvidiaColor}"/>
            <SolidColorBrush x:Key="BrTechAmd"    Color="{StaticResource TechAmdColor}"/>
            <SolidColorBrush x:Key="BrTechIntel"  Color="{StaticResource TechIntelColor}"/>
            <SolidColorBrush x:Key="BrSuccess" Color="{StaticResource StatusSuccessColor}"/>
            <SolidColorBrush x:Key="BrError"   Color="{StaticResource StatusErrorColor}"/>
            <SolidColorBrush x:Key="BrWarning" Color="{StaticResource StatusWarningColor}"/>

            <FontFamily x:Key="FontPrimary">Inter, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

            <!-- Four text sizes and no more, per DESIGN.md. Twelve were in use before,
                 from 9.5 to 22, which is why nothing read as a hierarchy. -->
            <x:Double x:Key="SizeTitle">18</x:Double>
            <x:Double x:Key="SizeHeading">14</x:Double>
            <x:Double x:Key="SizeBody">12.5</x:Double>
            <x:Double x:Key="SizeCaption">11</x:Double>

            <CornerRadius x:Key="RadiusChip">4</CornerRadius>
            <CornerRadius x:Key="RadiusControl">6</CornerRadius>
            <CornerRadius x:Key="RadiusCard">8</CornerRadius>
            <CornerRadius x:Key="RadiusArt">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <!-- Avalonia draws focus as a separate adorner visual outside the control,
                 which is why restyling BorderBrush alone never changed it. -->
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="{StaticResource BrAccent}" BorderThickness="1"
                            CornerRadius="6" Margin="-2"/>
                </FocusAdornerTemplate>
            </Setter>
            <Setter Property="FontFamily"    Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"      Value="{StaticResource SizeBody}"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="Background"    Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BrBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="14,8"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="CornerRadius"  Value="{StaticResource RadiusControl}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style Selector="Button.BtnPrimary">
            <Setter Property="Background"   Value="{StaticResource BrAccent}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BrAccent}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.BtnPrimary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrAccentHover}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrAccentHover}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrAccentPressed}"/>
        </Style>

        <Style Selector="Button.BtnDanger">
            <Setter Property="Background"  Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrError}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrError}"/>
        </Style>

        <!-- The card and the row from DESIGN.md. Every page was repeating these
             five setters, which is how they drifted apart. A row inside a card sits
             on surface-3: surface-1 on surface-1 is invisible. -->
        <Style Selector="Border.Card">
            <Setter Property="Background"      Value="{StaticResource BrBgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding"         Value="14"/>
        </Style>
        <Style Selector="Border.Row">
            <Setter Property="Background"   Value="{StaticResource BrBgSurface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding"      Value="12,10"/>
        </Style>

        <!-- A disclosure header whose content stays built. An Expander does not realise
             its content until it is first opened, which is right for a list nobody has
             asked for and wrong for controls whose state the screen has to read. -->
        <Style Selector="ToggleButton.Disclosure">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding"         Value="2,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="{StaticResource BrAccent}" BorderThickness="1"
                            CornerRadius="6" Margin="-2"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Disclosure /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.Disclosure:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.Disclosure:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
        </Style>

        <!-- A disclosure, for what only some people want to see. Fluent gives it a
             heavier chrome than a card; this makes it read as one. -->
        <Style Selector="Expander">
            <Setter Property="Background"      Value="{StaticResource BrBgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusCard}"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"        Value="{StaticResource SizeHeading}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="MinHeight"       Value="0"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource SizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
        </Style>
        <Style Selector="CheckBox, RadioButton, ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"   Value="{StaticResource SizeBody}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Background"  Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderDefault}"/>
        </Style>
        <!-- why: a focused ComboBox is filled with the accent rather than ringed with
             it. Fluent's template sets that fill as a local value on its own highlight
             border, which no selector or resource override reaches — see DESIGN.md. -->

        <Style Selector="TextBox">
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="Background"      Value="{StaticResource BrBgElevated}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusControl}"/>
            <Setter Property="FontSize"        Value="{StaticResource SizeBody}"/>
            <Setter Property="Padding"         Value="10,6"/>
        </Style>

        <!-- Couch/keyboard navigation: an unmistakable focus ring on the dark
             theme. Keyboard (or Steam Input mapped to keyboard) moves focus;
             these make it obvious where it is. -->
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:focus-visible">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="RadioButton:focus-visible, CheckBox:focus-visible">
            <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
        </Style>
        <Style Selector="ComboBox:focus-visible, TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
        </Style>
        <!-- ListBoxItem styling is intentionally NOT global: ComboBoxItem derives
             from ListBoxItem, so a global rule would corrupt every ComboBox dropdown.
             The game list styles its own items in MainWindow.axaml. -->
    </Application.Styles>
</Application>
