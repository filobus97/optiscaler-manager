<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UpscalerManager.App.ViewModels"
        x:Class="UpscalerManager.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
 Width="880" Height="640" MinWidth="720" MinHeight="480"
 WindowStartupLocation="CenterScreen"
 Background="{StaticResource BrBgBase}"
        XYFocus.NavigationModes="Keyboard,Gamepad"
 Icon="/Assets/icon-256.png"
 Title="Upscaler Manager">

  <Window.Styles>
    <!-- A card is a Button, so its chrome has to be replaced wholesale. -->
    <Style Selector="Button.GameCard">
      <Setter Property="Background" Value="{StaticResource BrBgSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <!-- why: Top would size the card's content to itself and centre it, so the
           bottom-anchored chip row would float with the title's line count. -->
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.GameCard:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrBorderDefault}"/>
    </Style>
    <Style Selector="Button.GameCard:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrBgElevated}"/>
    </Style>
    <!-- The focused card is outlined in the accent, so a controller user can always
         see where they are. -->
    <Style Selector="Button.GameCard:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Window.Styles>

  <Panel>
  <!-- Home: the game list. Pages (details, settings, install) replace it in place
       rather than opening windows — see IHostedPage. -->
  <Grid Name="HomeView" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
        <Image Source="/Assets/icon-64.png" Width="38" Height="38" VerticalAlignment="Center"/>
        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Upscaler Manager" FontSize="{StaticResource SizeTitle}" FontWeight="Bold"
 Foreground="{StaticResource BrTextPrimary}"/>
          <TextBlock Text="Manage the upscalers in your games."
 TextTrimming="CharacterEllipsis"
 Foreground="{StaticResource BrTextSecondary}"/>
        </StackPanel>
      </StackPanel>
      <!-- The filter belongs where the list is, not three screens away in Settings. -->
      <CheckBox Grid.Column="1" Name="ChkHideNoUpscaler" Content="Hide games with no upscaler"
 VerticalAlignment="Center" Margin="0,0,12,0"
 IsCheckedChanged="OnHideNoUpscalerChanged"
                ToolTip.Tip="Hides games with no DLSS, FSR or XeSS library, which neither route can help. They stay scanned, so turning this off brings them straight back."/>
      <Button Grid.Column="2" Name="RescanButton" Content="Rescan"
 Click="OnRescanClick" Margin="0,0,8,0"
 IsEnabled="{Binding IsIdle}"
              ToolTip.Tip="Re-scan your libraries (Steam, Epic, GOG, Xbox, EA, Battle.net, Ubisoft) for installed games."/>
      <Button Grid.Column="3" Name="SettingsButton" Content="Settings"
 Click="OnSettingsClick" IsEnabled="{Binding IsIdle}"
              ToolTip.Tip="The controller, the overlay key, download sources, storage, your own imported files, and app updates."/>
    </Grid>

    <!-- GPU banner -->
    <Border Grid.Row="1" Margin="0,16,0,0" Padding="12,10"
 CornerRadius="{StaticResource RadiusCard}"
 Background="{StaticResource BrBgCard}"
 BorderThickness="1" BorderBrush="{StaticResource BrBorderSubtle}"
            ToolTip.Tip="The GPU this app installs for. Install path guards apply whether or not it was detected.">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
 Background="{Binding GpuBrush}"/>
        <TextBlock Text="{Binding GpuText}" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextPrimary}"/>
      </StackPanel>
    </Border>

    <!-- Update-available banner (hidden unless a newer release exists) -->
    <Border Grid.Row="2" Name="UpdateBanner" IsVisible="False" Margin="0,10,0,0" Padding="12,8"
 CornerRadius="{StaticResource RadiusCard}"
 Background="{StaticResource BrBgElevated}"
 BorderThickness="1" BorderBrush="{StaticResource BrAccent}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Name="UpdateBannerText" Grid.Column="0" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextPrimary}" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Name="UpdateNowButton" Classes="BtnPrimary" Content="Update now" FontSize="{StaticResource SizeCaption}" Margin="8,0,0,0"
 Click="OnUpdateNowClick" IsEnabled="{Binding IsIdle}"
                ToolTip.Tip="Downloads and applies the update, then restarts the app automatically — no terminal (works in Steam Gaming Mode). Your settings, imports, profiles and backups are kept. Disabled while an install or revert is running."/>
        <Button Grid.Column="2" Content="Open releases page" FontSize="{StaticResource SizeCaption}" Margin="8,0"
 Click="OnOpenReleasesClick"
                ToolTip.Tip="Opens this app's GitHub releases page in your browser to read what changed."/>
        <Button Grid.Column="3" Content="✕" FontSize="{StaticResource SizeCaption}" Padding="8,4"
 Click="OnDismissUpdateBanner" ToolTip.Tip="Hide until next launch."/>
      </Grid>
    </Border>

    <!-- Game cards -->
    <Border Grid.Row="3" Margin="0,12,0,0"
 CornerRadius="{StaticResource RadiusCard}"
 Background="{StaticResource BrBgCard}"
 BorderThickness="1" BorderBrush="{StaticResource BrBorderSubtle}">
      <Grid>
        <!-- Each card is a single Button rather than a row of controls, which is what
             makes controller navigation free: XYFocus moves between cards spatially and
             Enter/A activates one. Everything you can do to a game lives on its details
             page, so a card needs exactly one action. -->
        <ScrollViewer Name="GamesScroller" Padding="8">
          <ItemsControl Name="GamesList" ItemsSource="{Binding VisibleGames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameRowViewModel">
                <Button Classes="GameCard" Width="188" Height="396" Margin="0,0,12,12" Padding="14"
 Click="OnDetailsClick"
                        ToolTip.Tip="{Binding CardTip}">
                  <!-- The middle row takes the slack, so a name that wraps to two lines
                       cannot push the chips down: every card carries them at the same
                       height. -->
                  <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">
                    <!-- Steam publishes library art at 2:3; the box is a little shorter
                         so a whole card fits the grid at the default window size, and
                         UniformToFill crops the difference. The placeholder sits behind
                         the image so a game without art keeps the shape. -->
                    <Border Grid.Row="0" Height="224" ClipToBounds="True"
 CornerRadius="{StaticResource RadiusArt}"
 Background="{StaticResource BrBgElevated}"
 BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
                      <Grid>
                        <TextBlock Text="&#x1F3AE;" FontSize="38" Opacity="0.45"
 HorizontalAlignment="Center" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}"/>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
 IsVisible="{Binding HasCoverImage}"/>
                      </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="{StaticResource SizeHeading}"
 FontWeight="SemiBold"
 MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
 Foreground="{StaticResource BrTextPrimary}"/>
                      <TextBlock Text="{Binding PlatformName}" FontSize="{StaticResource SizeCaption}"
 TextTrimming="CharacterEllipsis"
 Foreground="{StaticResource BrTextSecondary}"/>
                      <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource SizeCaption}"
 TextTrimming="CharacterEllipsis"
 Foreground="{Binding StatusBrush}"/>
                    </StackPanel>

                    <Panel Grid.Row="2" Margin="0,8,0,0">
                      <!-- What the game already has, with versions: "FSR" alone says
                           nothing, "FSR 4.1.1" answers the question. Chips wrap onto
                           three reserved rows, each tinted by vendor. -->
                      <ItemsControl Name="TechChipArea" ItemsSource="{Binding TechBadges}"
 Height="64" ClipToBounds="True"
 IsVisible="{Binding HasTechBadges}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TechBadge">
                            <Border Background="{StaticResource BrBgElevated}"
 CornerRadius="{StaticResource RadiusChip}"
 Padding="6,2" Margin="0,0,4,4">
                              <TextBlock Text="{Binding Label}" FontSize="{StaticResource SizeCaption}"
 Foreground="{Binding Accent}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Neither route can help a game with nothing to hook, so say so
                           rather than leaving the card looking half-scanned. -->
                      <Border IsVisible="{Binding HasNoUpscaler}"
 VerticalAlignment="Bottom" HorizontalAlignment="Left"
 Background="{StaticResource BrBgElevated}"
 CornerRadius="{StaticResource RadiusChip}"
 Padding="6,2"
                              ToolTip.Tip="No DLSS, FSR or XeSS library was found next to this game. OptiScaler hooks an upscaler a game already has rather than adding one, and there is nothing to swap — so neither route applies. If you believe this is wrong, the game may keep its libraries somewhere the scan does not reach.">
                        <TextBlock Text="No upscaler found" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
                      </Border>
                    </Panel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock IsVisible="{Binding HasNoGames}" HorizontalAlignment="Center" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}" TextAlignment="Center"
 Text="No games detected yet.&#x0a;Click Rescan, or import your own DLLs from Settings."/>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="4" Margin="0,12,0,0" Padding="12,8"
 CornerRadius="{StaticResource RadiusCard}"
 Background="{StaticResource BrBgSurface}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}" />
        <TextBlock Name="HiddenNoticeText" Text="{Binding HiddenNotice}" IsVisible="{Binding HasHiddenGames}"
 VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}"
                   ToolTip.Tip="Turn off &quot;Hide games with no upscaler&quot; in Settings to show them."/>
      </StackPanel>
    </Border>
  </Grid>

  <!-- Page host -->
  <Grid Name="PageView" IsVisible="False" RowDefinitions="Auto,*" Margin="20">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <Button Grid.Column="0" Name="BackButton" Content="&#x2190;  Back" Click="OnBackClick"
 Margin="0,0,12,0"
              ToolTip.Tip="Return to the game list (Esc, or B on a controller)."/>
      <TextBlock Grid.Column="1" Name="PageTitleText" VerticalAlignment="Center"
 FontSize="{StaticResource SizeTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
 Foreground="{StaticResource BrTextPrimary}"/>
    </Grid>
    <ContentControl Grid.Row="1" Name="PageContent"/>
  </Grid>
  </Panel>
</Window>
