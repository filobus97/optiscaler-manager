<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UpscalerManager.App.ViewModels"
        x:Class="UpscalerManager.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="880" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgBase}"
        XYFocus.NavigationModes="Keyboard,Gamepad"
        Icon="/Assets/icon-256.png"
        Title="Upscaler Manager">

  <Window.Styles>
    <!-- Scoped to the game list only (a global ListBoxItem rule would leak into
         ComboBox dropdowns, since ComboBoxItem derives from ListBoxItem). -->
    <Style Selector="ListBox#GamesList > ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <!-- The focused/selected game row lights up its card border. -->
    <Style Selector="ListBox#GamesList > ListBoxItem:selected Border.GameCard">
      <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
    </Style>
    <Style Selector="ListBox#GamesList > ListBoxItem:focus-visible Border.GameCard">
      <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
    </Style>
  </Window.Styles>

  <Panel>
  <!-- Home: the game list. Pages (details, settings, install) replace it in place
       rather than opening windows — see IHostedPage. -->
  <Grid Name="HomeView" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
        <Image Source="/Assets/icon-64.png" Width="38" Height="38" VerticalAlignment="Center"/>
        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Upscaler Manager" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource BrTextPrimary}"/>
          <TextBlock Text="Manage the upscalers in your games."
                     FontSize="13" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource BrTextSecondary}"/>
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Name="RescanButton" Content="Rescan"
              Click="OnRescanClick" Margin="0,0,8,0"
              IsEnabled="{Binding IsIdle}"
              ToolTip.Tip="Re-scan your libraries (Steam, Epic, GOG, Xbox, EA, Battle.net, Ubisoft) for installed games."/>
      <Button Grid.Column="2" Name="SettingsButton" Content="Settings"
              Click="OnSettingsClick" IsEnabled="{Binding IsIdle}"
              ToolTip.Tip="Import your own DLLs and .ini profiles, manage add-ons, set the overlay key, and check for app updates."/>
    </Grid>

    <!-- GPU banner -->
    <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,10"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource BrBgCard}"
            BorderThickness="1" BorderBrush="{StaticResource BrBorderSubtle}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                Background="{Binding GpuBrush}"/>
        <TextBlock Text="{Binding GpuText}" VerticalAlignment="Center"
                   Foreground="{StaticResource BrTextPrimary}" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>

    <!-- Update-available banner (hidden unless a newer release exists) -->
    <Border Grid.Row="2" Name="UpdateBanner" IsVisible="False" Margin="0,10,0,0" Padding="12,8"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="#2A2440"
            BorderThickness="1" BorderBrush="{StaticResource BrAccent}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Name="UpdateBannerText" Grid.Column="0" VerticalAlignment="Center"
                   Foreground="{StaticResource BrTextPrimary}" FontSize="12" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Name="UpdateNowButton" Classes="BtnPrimary" Content="Update now" FontSize="11" Margin="8,0,0,0"
                Click="OnUpdateNowClick" IsEnabled="{Binding IsIdle}"
                ToolTip.Tip="Downloads and applies the update, then restarts the app automatically — no terminal (works in Steam Gaming Mode). Your settings, imports, profiles and backups are kept. Disabled while an install or revert is running."/>
        <Button Grid.Column="2" Content="Open releases page" FontSize="11" Margin="8,0"
                Click="OnOpenReleasesClick"
                ToolTip.Tip="Opens this app's GitHub releases page in your browser to read what changed."/>
        <Button Grid.Column="3" Content="✕" FontSize="11" Padding="8,4"
                Click="OnDismissUpdateBanner" ToolTip.Tip="Hide until next launch."/>
      </Grid>
    </Border>

    <!-- Bring-your-own summary -->
    <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,8"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource BrBgSurface}"
            BorderThickness="1" BorderBrush="{StaticResource BrBorderSubtle}"
            ToolTip.Tip="Custom FSR components and OptiScaler.ini profiles you have imported. Select them per-install on the Install OptiScaler screen.">
      <TextBlock Text="{Binding ImportSummary}" Foreground="{StaticResource BrTextSecondary}"
                 FontSize="12" TextWrapping="Wrap"/>
    </Border>

    <!-- Game list -->
    <Border Grid.Row="4" Margin="0,12,0,0"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource BrBgCard}"
            BorderThickness="1" BorderBrush="{StaticResource BrBorderSubtle}">
      <Grid>
        <!-- ListBox (not ItemsControl) so Up/Down walks the game rows with the
             keyboard/controller; the focused row's buttons are one Right away.
             Left/Right across the row's three cells is wired up in the code-behind. -->
        <ListBox Name="GamesList" ItemsSource="{Binding Games}" Margin="8"
                 Background="Transparent" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GameRowViewModel">
              <Border Classes="GameCard" Padding="14,12"
                      CornerRadius="{StaticResource RadiusMedium}"
                      Background="{StaticResource BrBgSurface}"
                      BorderThickness="1" BorderBrush="{StaticResource BrBorderSubtle}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource BrTextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubTitle}" FontSize="11"
                               Foreground="{StaticResource BrTextSecondary}" TextTrimming="CharacterEllipsis"/>
                    <!-- Status plus what the game already has, with versions: "FSR" alone
                         says nothing, "FSR 4.1.1" answers the question. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{StaticResource BrAccent}"/>
                      <ItemsControl ItemsSource="{Binding TechBadges}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Background="{StaticResource BrBgElevated}"
                                    BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}" Padding="6,1">
                              <TextBlock Text="{Binding}" FontSize="10.5"
                                         Foreground="{StaticResource BrTextSecondary}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <Button Grid.Column="1" Classes="BtnPrimary" Content="Install OptiScaler"
                          Margin="0,0,8,0" Click="OnInstallClick"
                          IsEnabled="{Binding IsIdle}"
                          ToolTip.Tip="Download and install OptiScaler for this game. The next screen lets you choose the version, backend, add-ons and OptiScaler.ini — and shows exactly what will change before anything is written."/>
                  <Button Grid.Column="2" Content="Details  &#x203A;"
                          Click="OnDetailsClick"
                          ToolTip.Tip="What upscaling technology this game has and at which version, what OptiScaler is set to do, and the option to remove it."/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock IsVisible="{Binding HasNoGames}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource BrTextSecondary}" TextAlignment="Center"
                   Text="No games detected yet.&#x0a;Click Rescan, or import your own DLLs from Settings."/>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="5" Margin="0,12,0,0" Padding="12,8"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource BrBgSurface}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                   Foreground="{StaticResource BrTextSecondary}" FontSize="12"/>
      </StackPanel>
    </Border>
  </Grid>

  <!-- Page host -->
  <Grid Name="PageView" IsVisible="False" RowDefinitions="Auto,*" Margin="20">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <Button Grid.Column="0" Name="BackButton" Content="&#x2190;  Back" Click="OnBackClick"
              Margin="0,0,12,0"
              ToolTip.Tip="Return to the game list (Esc, or B on a controller)."/>
      <TextBlock Grid.Column="1" Name="PageTitleText" VerticalAlignment="Center"
                 FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource BrTextPrimary}"/>
    </Grid>
    <ContentControl Grid.Row="1" Name="PageContent"/>
  </Grid>
  </Panel>
</Window>
