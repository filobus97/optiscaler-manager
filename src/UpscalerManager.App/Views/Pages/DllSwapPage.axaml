<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UpscalerManager.App.Views.Pages.DllSwapPage"
        XYFocus.NavigationModes="Keyboard,Gamepad">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Name="HeadingText" FontWeight="SemiBold" FontSize="14"
                 Foreground="{StaticResource BrTextPrimary}"/>
      <TextBlock Name="ExplanationText" TextWrapping="Wrap" FontSize="12"
                 Foreground="{StaticResource BrTextSecondary}"/>
      <Border Name="WarningBox" IsVisible="False" Margin="0,6,0,0" Padding="10" CornerRadius="6"
              Background="#3D1F1F" BorderBrush="{StaticResource BrError}" BorderThickness="1">
        <TextBlock Name="WarningText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource BrTextPrimary}"/>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
      <StackPanel Spacing="14" Margin="0,0,10,4">

        <!-- What is in the game right now, and how to undo it -->
        <Border Padding="14" CornerRadius="8" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
          <StackPanel Name="CurrentPanel" Spacing="8"/>
        </Border>

        <!-- Builds already held -->
        <StackPanel Spacing="6">
          <TextBlock Text="In your library" FontWeight="SemiBold"
                     Foreground="{StaticResource BrTextPrimary}"/>
          <Border Padding="14" CornerRadius="8" Background="{StaticResource BrBgCard}"
                  BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
            <StackPanel Name="LibraryPanel" Spacing="6"/>
          </Border>
        </StackPanel>

        <!-- Builds sitting in the user's other games -->
        <StackPanel Spacing="6">
          <TextBlock Text="Already on your disk" FontWeight="SemiBold"
                     Foreground="{StaticResource BrTextPrimary}"/>
          <Border Padding="14" CornerRadius="8" Background="{StaticResource BrBgCard}"
                  BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" FontSize="11.5"
                         Foreground="{StaticResource BrTextSecondary}"
                         Text="Builds in your other games, and in the OptiScaler releases and community builds this app has already downloaded. Nothing is fetched for these — they work offline, and adding one copies it into the library, leaving the source untouched."/>
              <StackPanel Name="HarvestPanel" Spacing="6"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Third-party community builds, for the FSR upscaler only -->
        <StackPanel Name="CommunitySection" Spacing="6" IsVisible="False">
          <TextBlock Text="FSR 4 community builds" FontWeight="SemiBold"
                     Foreground="{StaticResource BrTextPrimary}"/>
          <Border Padding="14" CornerRadius="8" Background="{StaticResource BrBgCard}"
                  BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" FontSize="11.5"
                         Foreground="{StaticResource BrTextSecondary}"
                         Text="From github.com/Agustinm28/OptiScaler-Extras — a third party, not AMD and not the OptiScaler project. These INT8 builds are the way to FSR 4 on hardware whose driver does not provide it. Entries marked pre-release are ones their author has not declared stable."/>
              <StackPanel Name="CommunityPanel" Spacing="6"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Straight from the vendor -->
        <StackPanel Spacing="6">
          <TextBlock Text="Download from the vendor" FontWeight="SemiBold"
                     Foreground="{StaticResource BrTextPrimary}"/>
          <Border Padding="14" CornerRadius="8" Background="{StaticResource BrBgCard}"
                  BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Name="VendorNoteText" TextWrapping="Wrap" FontSize="11.5"
                         Foreground="{StaticResource BrTextSecondary}"/>
              <StackPanel Name="VendorPanel" Spacing="6"/>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
      <Button Name="ImportButton" Content="Import a DLL…" Click="OnImport"
              ToolTip.Tip="Pick a DLL you already have. It has to be a 64-bit build of one of the swappable files, and carry a version — otherwise there is no way to tell it apart from what is already in the game."/>
      <TextBlock Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                 Foreground="{StaticResource BrTextSecondary}"/>
      <Button Name="CloseButton" Content="Done" Click="OnClose" IsCancel="True"
              HorizontalAlignment="Right"
              ToolTip.Tip="Back to the game (Esc, or B on a controller)."/>
    </StackPanel>
  </Grid>
</UserControl>
