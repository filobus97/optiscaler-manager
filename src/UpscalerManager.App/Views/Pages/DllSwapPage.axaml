<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UpscalerManager.App.Views.Pages.DllSwapPage"
        XYFocus.NavigationModes="Keyboard,Gamepad">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0" Name="SubtitleText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>

    <!-- Said once, however many rows it applies to. -->
    <TextBlock Grid.Row="1" Name="GuardNoteText" IsVisible="False" TextWrapping="Wrap"
 Margin="0,8,0,0" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrWarning}"/>

    <Border Grid.Row="2" Name="WarningBox" IsVisible="False" Margin="0,12,0,0" Padding="12,10"
 CornerRadius="{StaticResource RadiusControl}"
 Background="{StaticResource BrBgElevated}"
 BorderBrush="{StaticResource BrError}" BorderThickness="1">
      <TextBlock Name="WarningText" TextWrapping="Wrap"/>
    </Border>

    <!-- One list, newest first, whatever each build came from: the source is a caption
         on the row rather than a headed section of its own. -->
    <ScrollViewer Grid.Row="3" Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel Spacing="6" Margin="0,0,8,4">
        <StackPanel Name="BuildList" Spacing="6"/>
        <TextBlock Name="ListNoteText" TextWrapping="Wrap" Margin="2,4,0,0"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
      <Button Name="ImportButton" Content="Import…" Click="OnImport"
              ToolTip.Tip="Add DLLs you already have, or zips holding them. They have to be 64-bit builds of a file this app swaps, and carry a version."/>
      <TextBlock Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
      <Button Name="CloseButton" Content="Done" Click="OnClose" IsCancel="True"
 HorizontalAlignment="Right"
              ToolTip.Tip="Back to the game (Esc, or B on a controller)."/>
    </StackPanel>
  </Grid>
</UserControl>
