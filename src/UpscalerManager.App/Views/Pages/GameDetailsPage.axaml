<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UpscalerManager.App.Views.Pages.GameDetailsPage">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Where the game lives -->
    <TextBlock Grid.Row="0" Name="SubtitleText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>

    <ScrollViewer Grid.Row="1" Name="PageScroller" Margin="0,16,0,0">
      <StackPanel Spacing="12">

        <!-- OptiScaler first, and the only primary action on the page: it is the route
             that can help any game, where a swap only upgrades a library the game
             already ships. -->
        <Border Classes="Card">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="OptiScaler" FontSize="{StaticResource SizeHeading}"
 FontWeight="SemiBold"/>
              <TextBlock Name="OptiScalerStateText" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>
            <Button Grid.Column="1" Name="InstallButton" Classes="BtnPrimary"
 Content="Install OptiScaler" Click="OnInstallClick"
 VerticalAlignment="Center"
                    ToolTip.Tip="Choose the version, the upscaler to run and the add-ons, and see exactly what will change before anything is written."/>
            <Button Grid.Column="2" Name="RevertButton" Classes="BtnDanger" Content="Remove"
 Margin="8,0,0,0" Click="OnRevertClick" VerticalAlignment="Center"
                    ToolTip.Tip="Put back the files that were here before and remove everything the install added."/>
          </Grid>
        </Border>

        <!-- One row per swappable library the game actually has, with what is in it
             now and the newest build this app can reach. -->
        <Border Classes="Card">
          <StackPanel Spacing="8">
            <TextBlock Text="Upscaler libraries" FontSize="{StaticResource SizeHeading}"
 FontWeight="SemiBold"/>
            <StackPanel Name="SwapList" Spacing="6"/>
            <TextBlock Name="NoSwapsText" IsVisible="False" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          </StackPanel>
        </Border>

        <!-- Everything found next to the game, and what OptiScaler is set to do with
             it. Collapsed: it answers "why is it doing that?", which is not the
             question most visits are here to ask. -->
        <Expander Name="DetailsExpander">
          <Expander.Header>
            <TextBlock Text="Details" FontSize="{StaticResource SizeHeading}" FontWeight="SemiBold"/>
          </Expander.Header>
          <StackPanel Spacing="12" Margin="0,0,0,4">
            <StackPanel Spacing="6">
              <TextBlock Text="Found in this game" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
              <StackPanel Name="ComponentsList" Spacing="6"/>
              <TextBlock Name="NoComponentsText" IsVisible="False" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"
 Text="No upscaling technology found. Installing OptiScaler adds it."/>
            </StackPanel>
            <StackPanel Name="ConfigList" Spacing="6"/>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
      <Button Name="RescanButton" Content="Re-scan this game" Click="OnRescanClick"
              ToolTip.Tip="Read the game folder again — use this after changing files by hand."/>
      <Button Content="Back to games" Click="OnCloseClick" IsCancel="True"
              ToolTip.Tip="Back to the game list (Esc, or B on a controller)."/>
    </StackPanel>
  </Grid>
</UserControl>
