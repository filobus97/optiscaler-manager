<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UpscalerManager.App.Views.Pages.InstallPage"
        XYFocus.NavigationModes="Keyboard,Gamepad">

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="0,0,8,4">

      <!-- Above everything else, because it can cost the player more than a broken
           install: a banned account. -->
      <Border Name="AntiCheatBox" IsVisible="False" Padding="12,10"
 CornerRadius="{StaticResource RadiusControl}"
 Background="{StaticResource BrBgElevated}"
 BorderBrush="{StaticResource BrWarning}" BorderThickness="1">
        <TextBlock Name="AntiCheatText" TextWrapping="Wrap"
 Foreground="{StaticResource BrTextPrimary}"/>
      </Border>

      <!-- The primary path: which release, which upscaler it should run, and where its
           FSR 4 comes from. Everything else has a defensible default and lives under Advanced. -->
      <Border Classes="Card">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" VerticalAlignment="Center"
 Margin="0,0,12,0" Foreground="{StaticResource BrTextSecondary}"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <RadioButton Name="RbChannelStable" GroupName="Channel" Content="Stable" IsChecked="True"
                           ToolTip.Tip="OptiScaler's releases."/>
              <RadioButton Name="RbChannelBeta" GroupName="Channel" Content="Beta"
                           ToolTip.Tip="Pre-releases: builds on their way to the next release."/>
              <RadioButton Name="RbChannelNightly" GroupName="Channel" Content="Nightly"
                           ToolTip.Tip="A build of OptiScaler's development branch, made every day and not tested before it is published."/>
            </StackPanel>
            <ComboBox Name="OptiScalerVersionCombo" MinWidth="260" HorizontalAlignment="Left"
                      ToolTip.Tip="Which OptiScaler release to install. Older ones are offered for troubleshooting, or to reproduce a setup that worked."/>
            <TextBlock Name="ChannelNoteText" TextWrapping="Wrap" IsVisible="False"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Upscaler" VerticalAlignment="Center"
 Margin="0,10,12,0" Foreground="{StaticResource BrTextSecondary}"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Name="UpscalerCombo" MinWidth="260" Margin="0,10,0,0"
 HorizontalAlignment="Left" SelectionChanged="OnOptionChanged"
                    ToolTip.Tip="The upscaler a game asks for need not be the one it gets — this is what OptiScaler is for. The same list its own overlay offers, and you can change it in-game at any time."/>
          <TextBlock Grid.Row="2" Grid.Column="1" Name="UpscalerNoteText" Margin="0,4,0,0"
 FontSize="{StaticResource SizeCaption}" TextWrapping="Wrap"
 Foreground="{StaticResource BrTextSecondary}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="FSR 4 from" VerticalAlignment="Top"
 Margin="0,14,12,0" Foreground="{StaticResource BrTextSecondary}"/>
          <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6" Margin="0,12,0,0">
            <RadioButton Name="RbAmdDriver" GroupName="Fsr4" IsVisible="False"
                         ToolTip.Tip="AMD's own FSR 4, from the amdxcffx64.dll (DirectX 12) and amdvkffx64.dll (Vulkan) you imported in Settings. They go next to OptiScaler, which loads them before the driver's own. Needed on Linux, where there is no AMD driver to find them in; on Windows your installed driver already provides them."/>
            <StackPanel Name="AmdDriverVersionPanel" Orientation="Horizontal" Spacing="8"
 Margin="26,0,0,0" IsVisible="False">
              <TextBlock Text="Files" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}"/>
              <ComboBox Name="AmdDriverVersionCombo" MinWidth="200"/>
            </StackPanel>
            <RadioButton Name="RbDefault" GroupName="Fsr4" Content="OptiScaler's own"
                         ToolTip.Tip="Install the release exactly as it ships. It bundles the newest FSR upscaler it can hook and hooks the game's own DLSS and XeSS where present, so this is right on any GPU unless you have a reason to replace a file."/>
            <RadioButton Name="RbCustomMerged" GroupName="Fsr4" Content="Your custom DLLs"
                         ToolTip.Tip="Your imported DLLs overlaid on the install: names OptiScaler ships are swapped in place, unknown ones are added alongside. Import them in Settings. OptiScaler can only hook FSR binaries it has patterns for, so a mismatched upscaler build silently disables FSR 4."/>
            <RadioButton Name="RbInt8" GroupName="Fsr4" Content="FSR 4 INT8 community build"
                         ToolTip.Tip="A community FSR 4 INT8 build from github.com/Agustinm28/OptiScaler-Extras — a third-party repo, not part of OptiScaler. This is the route to FSR 4 without a driver that provides it."/>
            <StackPanel Name="Int8VersionPanel" Orientation="Horizontal" Spacing="8"
 Margin="26,0,0,0" IsVisible="False">
              <TextBlock Text="Build" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}"/>
              <ComboBox Name="Int8VersionCombo" MinWidth="200"
                        ToolTip.Tip="Every release that repo publishes, newest first. Entries marked pre-release are builds its author has not declared stable."/>
            </StackPanel>
            <RadioButton Name="RbFaster" GroupName="Fsr4" Content="Faster FSR 4.1.1 (shader overrides)"
                         ToolTip.Tip="AMD's FSR 4.1.1 with its slowest shaders rewritten, from github.com/zgauthier2000/fsr4-shader-performance-overrides — a third-party project. It replaces the FSR 4.1.1 upscaler OptiScaler installs, with the build made for your GPU. Turn it on under Settings → Sources."/>
            <StackPanel Name="FasterPanel" Spacing="4" Margin="26,0,0,0" IsVisible="False">
              <ComboBox Name="FasterKindCombo" MinWidth="260"
                        ToolTip.Tip="Exact keeps AMD's image byte for byte. Lossy is about twice as fast as AMD's, at the cost of a softer image and frame times that alternate between short and long."/>
              <TextBlock Name="FasterNoteText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>
            <RadioButton Name="RbOmni" GroupName="Fsr4" Content="Several builds, switchable in-game (experimental)"
                         ToolTip.Tip="Puts the omniloader in place of OptiScaler's FSR upscaler. It loads every build you tick, and OptiScaler's overlay lists all their versions under FFX Upscaler, so you can switch between them without restarting the game."/>
            <StackPanel Name="OmniPanel" Spacing="4" Margin="26,0,0,0" IsVisible="False">
              <StackPanel Name="OmniList" Spacing="2"/>
              <TextBlock Name="OmniNoteText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"
 Text="The first build ticked runs until you pick another in OptiScaler's overlay, under FFX Upscaler. Experimental: OptiScaler's FSR 4 model override does not reach builds behind the omniloader."/>
            </StackPanel>
            <TextBlock Name="Fsr4SourceNoteText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            <!-- Where FSR 4 could come from but does not yet: the files are the player's own. -->
            <StackPanel Name="ImportDriverHint" Spacing="6" IsVisible="False">
              <TextBlock TextWrapping="Wrap" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"
 Text="AMD's newest FSR 4, with a model for every Radeon, is in AMD's driver files. They are never downloaded here: import them from AMD's driver installer, or an archive or folder that holds them."/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="ImportDriverButton" Content="Import AMD driver files…" Click="OnImportDriverFiles"/>
                <TextBlock Name="ImportDriverStatus" VerticalAlignment="Center" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="4" Grid.Column="0" Name="FfxVersionLabel" Text="FSR version"
 VerticalAlignment="Center" IsVisible="False"
 Margin="0,10,12,0" Foreground="{StaticResource BrTextSecondary}"/>
          <ComboBox Grid.Row="4" Grid.Column="1" Name="FfxVersionCombo" MinWidth="260" Margin="0,10,0,0"
 HorizontalAlignment="Left" IsVisible="False" SelectionChanged="OnOptionChanged"
                    ToolTip.Tip="One FidelityFX code covers FSR 2.3, 3.1 and 4.x — this picks which of them runs, via [FSR] UpscalerIndex."/>
          <TextBlock Grid.Row="5" Grid.Column="1" Name="FfxVersionNoteText" Margin="0,4,0,0"
 FontSize="{StaticResource SizeCaption}" TextWrapping="Wrap" IsVisible="False"
 Foreground="{StaticResource BrTextSecondary}"/>
        </Grid>
      </Border>

      <!-- Everything with a defensible default. Hidden rather than unbuilt: these
           controls feed the preview, and a collapsed Expander has no controls to read. -->
      <ToggleButton Name="AdvancedToggle" Classes="Disclosure" IsCheckedChanged="OnAdvancedToggled">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Advanced" FontSize="{StaticResource SizeHeading}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Name="AdvancedChevron" Text="&#x2304;"
 Foreground="{StaticResource BrTextSecondary}"/>
        </Grid>
      </ToggleButton>

      <Border Name="AdvancedPanel" Classes="Card" IsVisible="False">
        <StackPanel Spacing="10">

          <TextBlock Text="FSR 4" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          <StackPanel Spacing="6">
            <StackPanel Name="Fsr4ModelPanel" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Model" VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}"/>
                <ComboBox Name="Fsr4ModelCombo" MinWidth="300"
                          ToolTip.Tip="Which FSR 4 model OptiScaler asks for ([FSR] Fsr4Model). AMD's FSR 4.1.2 carries four: FP8 for RX 9000, INT8 for RX 7000, an INT8 model for RX 6000, and INT8 Lite for integrated graphics. You can change it in OptiScaler's overlay while the game runs."/>
              </StackPanel>
              <TextBlock Name="Fsr4ModelNoteText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>
            <CheckBox Name="ChkForceFsr4" Content="Run FSR 4 even where OptiScaler says this GPU can't"
                      ToolTip.Tip="Overrides the support OptiScaler detects for the GPU, under the name this OptiScaler release uses ([FSR] Fsr4GpuSupport, Fsr4ForceModel or Fsr4ForceEnableInt8). It cannot make a GPU run a model it lacks the hardware for; INT8 Lite is the one any GPU can run."/>
            <CheckBox Name="ChkWatermark" Content="Show the FSR 4 watermark, to verify"
                      ToolTip.Tip="Draws a watermark reporting FSR4, FSR4-i8 or FSR3 — the reliable way to see whether FSR 4 is really running or fell back. Turn it off once verified."/>
          </StackPanel>

          <Border Height="1" Background="{StaticResource BrBorderSubtle}" Margin="0,2"/>

          <TextBlock Text="Add-ons" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          <StackPanel Spacing="6">
            <CheckBox Name="ChkFakenvapi" Content="fakenvapi — Reflex to Anti-Lag 2 or LatencyFlex"
                      ToolTip.Tip="Installs nvapi64.dll and fakenvapi.ini from the optiscaler/fakenvapi releases. Translates Nvidia Reflex calls, and is required for Nukem's frame generation on AMD and Intel."/>
            <CheckBox Name="ChkNukemFg" Content="Nukem DLSSG-to-FSR3 frame generation"
                      ToolTip.Tip="Installs your imported dlssg_to_fsr3_amd_is_better.dll and turns frame generation on, with the keys this OptiScaler release reads. Needs fakenvapi on AMD and Intel, so it selects that too."/>
          </StackPanel>

          <Border Height="1" Background="{StaticResource BrBorderSubtle}" Margin="0,2"/>

          <TextBlock Text="Nvidia override" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          <StackPanel Spacing="6">
            <ComboBox Name="SpoofCombo" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Whether this game is told it has an Nvidia GPU, which is what unlocks a DLSS option on AMD and Intel. Off unless a game hides its DLSS option: nothing else needs it, and some games crash when the adapter lies. OptiPatcher is the alternative — it patches the game's own vendor check instead of lying, for the games it supports."/>
            <TextBlock Name="SpoofNoteText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          </StackPanel>

          <Border Height="1" Background="{StaticResource BrBorderSubtle}" Margin="0,2"/>

          <TextBlock Text="OptiScaler.ini" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          <ComboBox Name="ProfileCombo" HorizontalAlignment="Stretch"
                    ToolTip.Tip="The base .ini to write. Only the keys listed in the preview are overridden; everything else in the chosen file is left intact. Import your own in Settings."/>
        </StackPanel>
      </Border>

      <!-- The preview is the best thing on this screen, so it is never hidden: nothing
           else in this space shows the diff before it is written. -->
      <Border Classes="Card">
        <StackPanel Spacing="12">
          <Border Name="ConflictBox" IsVisible="False" Padding="12,10"
 CornerRadius="{StaticResource RadiusControl}"
 Background="{StaticResource BrBgElevated}"
 BorderBrush="{StaticResource BrError}" BorderThickness="1">
            <StackPanel Name="ConflictList" Spacing="3"/>
          </Border>

          <StackPanel Spacing="6">
            <TextBlock Text="Files written next to the game" FontSize="{StaticResource SizeHeading}"
 FontWeight="SemiBold"/>
            <StackPanel Name="FilesList" Spacing="3"/>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="OptiScaler.ini keys set" FontSize="{StaticResource SizeHeading}"
 FontWeight="SemiBold"/>
            <StackPanel Name="IniList" Spacing="3"/>
          </StackPanel>

          <TextBlock Text="Anything already there is backed up before it is overwritten, so Remove can put it back."
 FontSize="{StaticResource SizeCaption}" TextWrapping="Wrap"
 Foreground="{StaticResource BrTextSecondary}"/>
        </StackPanel>
      </Border>

    </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
 Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True"
              ToolTip.Tip="Close without changing anything (Esc)."/>
      <Button Name="ConfirmButton" Classes="BtnPrimary" Content="Confirm and install"
 Click="OnConfirm" IsDefault="True"
              ToolTip.Tip="Install exactly what the preview shows (Enter)."/>
    </StackPanel>
  </Grid>
</UserControl>
