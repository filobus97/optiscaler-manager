<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UpscalerManager.App.Views.Pages.SettingsPage"
        XYFocus.NavigationModes="Keyboard,Gamepad">

  <Grid RowDefinitions="*,Auto">

    <!-- Six things, each its own row, in the order they are likely to be wanted. The
         group headings and their paragraphs are gone: a setting that needs a paragraph
         is a setting that is wrong. -->
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12" Margin="0,0,8,4">

        <Border Classes="Card">
          <StackPanel Spacing="4">
            <CheckBox Name="GamepadCheck" Content="Controller navigation"
                      ToolTip.Tip="Drive the whole app with a controller: D-pad or left stick to move, right stick to scroll, A to open or confirm, B to go back. Reads the controller directly; if Steam Input is already mapping it to the keyboard, that is detected and left alone. Takes effect on the next start."/>
            <TextBlock Name="GamepadStatusText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="OptiScaler overlay key" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Name="MenuKeyCombo" MinWidth="220"
                      ToolTip.Tip="The key that opens OptiScaler's overlay in game, written as [Menu] ShortcutKey on every install. The default is Insert, which not every keyboard has."/>
          </Grid>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="4">
            <CheckBox Name="ChkRepositoryDownloads" Content="Download builds from the DLSS Swapper archive"
 IsCheckedChanged="OnSwapSourceChanged"
                      ToolTip.Tip="A third-party mirror of shipped builds, hosted by the DLSS Swapper project — the only source for old DLSS releases and for AMD's FidelityFX runtimes. Downloads are checked against the hashes its index publishes. Builds already on your disk are always offered and need no network."/>
            <TextBlock Name="RepositoryNoteText" TextWrapping="Wrap"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Storage"/>
              <TextBlock Name="StorageTotalText" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>
            <Button Grid.Column="1" Name="StorageButton" Content="Manage storage  &#x203A;"
 VerticalAlignment="Center" Click="OnManageStorage"
                    ToolTip.Tip="Everything the app has written to disk, with sizes, grouped by how safe each thing is to remove. Nothing is deleted automatically."/>
          </Grid>
        </Border>

        <!-- The bring-your-own imports. One-time setup, so they are folded away rather
             than sitting above the settings people actually come here to change. -->
        <ToggleButton Name="OwnFilesToggle" Classes="Disclosure" IsCheckedChanged="OnOwnFilesToggled">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Your own files" FontSize="{StaticResource SizeHeading}"
 FontWeight="SemiBold"/>
              <TextBlock Name="InventoryText" FontSize="{StaticResource SizeCaption}"
 FontWeight="Normal" TextWrapping="Wrap"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Name="OwnFilesChevron" Text="&#x2304;"
 VerticalAlignment="Center"
 Foreground="{StaticResource BrTextSecondary}"/>
          </Grid>
        </ToggleButton>

        <Border Name="OwnFilesPanel" Classes="Card" IsVisible="False">
          <StackPanel Spacing="10">

            <TextBlock Text="Nukem DLSSG-to-FSR3" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Import the DLL…" Click="OnImportNukemFg"
                      ToolTip.Tip="Pick dlssg_to_fsr3_amd_is_better.dll, or the archive it came in. It cannot be downloaded for you, so it is imported once and then offered on every install."/>
              <TextBlock Name="NukemStatusText" VerticalAlignment="Center"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BrBorderSubtle}" Margin="0,2"/>

            <TextBlock Text="OptiScaler.ini profiles" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="ProfileNameBox" Width="220" PlaceholderText="Name (optional)"/>
              <Button Content="Import .ini…" Click="OnImportIni"
                      ToolTip.Tip="Pick an OptiScaler.ini. It is saved under the name given and can be chosen when installing; blank uses the file name."/>
            </StackPanel>
            <StackPanel Name="IniProfilesList" Spacing="4"/>

            <Border Height="1" Background="{StaticResource BrBorderSubtle}" Margin="0,2"/>

            <TextBlock Text="Custom DLLs" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Files…" Click="OnImportDlls"
                      ToolTip.Tip="Pick one or more .dll files. Each is checked as a 64-bit Windows DLL before it is kept."/>
              <Button Content="Folder…" Click="OnImportDllFolder"
                      ToolTip.Tip="Pick a folder — every 64-bit DLL inside it is imported, and the largest copy of a duplicated name wins."/>
              <Button Content="Archive…" Click="OnImportDllArchive"
                      ToolTip.Tip="Pick a .zip, .7z or .rar — every 64-bit DLL inside it is imported."/>
            </StackPanel>
            <StackPanel Name="CustomDllsList" Spacing="4"/>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="8">
            <TextBlock Name="AppVersionText" TextWrapping="Wrap"/>
            <TextBlock Name="LogPathText" TextWrapping="Wrap" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="OpenLogButton" Content="Open the log folder" Click="OnOpenLogFolder"
                      ToolTip.Tip="Everything the app did this session and last, written as it happens. Attach it to a bug report — it is what makes an install that went wrong diagnosable."/>
              <Button Content="Check for updates" Click="OnCheckAppUpdate"
                      ToolTip.Tip="Asks GitHub whether a newer release of this app exists."/>
              <Button Name="UpdateNowButton" Classes="BtnPrimary" Content="Update now" IsEnabled="False"
 Click="OnUpdateNow"
                      ToolTip.Tip="Downloads and applies the update, then restarts — no terminal, so it works in Steam Gaming Mode. Your settings, imports, profiles and backups are kept."/>
            </StackPanel>
            <TextBlock Name="AppUpdateResultText" TextWrapping="Wrap" IsVisible="False"
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="SupportButton" Content="Support the project  &#x2197;"
 Click="OnOpenSupportPage"
                      ToolTip.Tip="Optional, and nothing here is gated behind it. Opens the project's page in your browser."/>
              <TextBlock Name="SupportResultText" VerticalAlignment="Center"
 FontSize="{StaticResource SizeCaption}" TextWrapping="Wrap" IsVisible="False"
 Foreground="{StaticResource BrTextSecondary}"/>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <!-- Where every "done that" message lands. It used to be written to a control
           that did not exist, so an import reported nothing at all. -->
      <TextBlock Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap"
 Margin="0,0,12,0" FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
      <Button Grid.Column="1" Content="Back to games" Click="OnClose" IsCancel="True"
              ToolTip.Tip="Back to the game list (Esc, or B on a controller). Everything here saves as you change it."/>
    </Grid>
  </Grid>
</UserControl>
