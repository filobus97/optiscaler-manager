<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UpscalerManager.App.Views.Pages.StoragePage"
        XYFocus.NavigationModes="Keyboard,Gamepad">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Name="TotalText" FontWeight="SemiBold"
 Foreground="{StaticResource BrTextPrimary}"/>
      <TextBlock Text="Nothing here is removed automatically."
 FontSize="{StaticResource SizeCaption}"
 Foreground="{StaticResource BrTextSecondary}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,0">
      <StackPanel Name="GroupsPanel" Spacing="16"/>
    </ScrollViewer>

    <Border Grid.Row="2" Name="StatusBar" IsVisible="False" Margin="0,12,0,0" Padding="12,8"
 CornerRadius="{StaticResource RadiusCard}"
 Background="{StaticResource BrBgSurface}">
      <TextBlock Name="StatusText" TextWrapping="Wrap"
 Foreground="{StaticResource BrTextSecondary}"/>
    </Border>
  </Grid>
</UserControl>
